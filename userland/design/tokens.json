{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "product": "Xdos userland",
    "figmaFileHint": "Map these names to Figma Variables (color + number modes).",
    "vgaNote": "color.*.vga maps to src/vga_buffer.rs Color enum (low 4 bits)."
  },
  "color": {
    "fg": { "default": { "vga": 7, "hex": "#AAAAAA" }, "accent": { "vga": 11, "hex": "#55FFFF" } },
    "bg": { "default": { "vga": 0, "hex": "#000000" }, "panel": { "vga": 1, "hex": "#0000AA" } },
    "status": {
      "ok": { "vga": 10, "hex": "#55FF55" },
      "warn": { "vga": 14, "hex": "#FFFF55" },
      "error": { "vga": 12, "hex": "#FF5555" }
    }
  },
  "font": {
    "family": { "terminal": { "value": "IBM VGA 8x16 / CP437" } },
    "size": { "body": { "px": 16 }, "caption": { "px": 16 } }
  },
  "layout": {
    "screen": { "columns": 80, "rows": 25 },
    "shell": {
      "prompt": { "value": "xdos> " },
      "marginX": { "px": 2 },
      "marginY": { "px": 1 }
    }
  },
  "component": {
    "button": {
      "paddingX": { "px": 2 },
      "paddingY": { "px": 0 },
      "fg": { "vga": 15 },
      "bg": { "vga": 9 }
    }
  }
}
