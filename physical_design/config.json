{
    "meta": {
        "version": 2,
        "flow": "Classic"
    },
    "DESIGN_NAME": "gpu",
    "VERILOG_FILES": [
        "dir::build/gpu_sv2v.v"
    ],
    "CLOCK_PORT": "clk",
    "CLOCK_NET": "clk",
    "CLOCK_PERIOD": 25.0,
    "PNR_SDC_FILE": "dir::constraint.sdc",
    "SIGNOFF_SDC_FILE": "dir::constraint.sdc",
    "FP_PIN_ORDER_CFG": "dir::pin_order.cfg",
    "FP_SIZING": "relative",
    "FP_CORE_UTIL": 35,
    "FP_ASPECT_RATIO": 1.0,
    "FP_IO_MIN_DISTANCE": 2.0,
    "PL_TARGET_DENSITY_PCT": 50,
    "SYNTH_STRATEGY": "AREA 0",
    "SYNTH_MAX_FANOUT": 10,
    "GRT_ADJUSTMENT": 0.25,
    "CTS_CLK_MAX_WIRE_LENGTH": 500,
    "DIODE_ON_PORTS": "both",
    "RUN_HEURISTIC_DIODE_INSERTION": true,
    "RUN_ANTENNA_REPAIR": true,
    "RUN_POST_GRT_DESIGN_REPAIR": true,
    "RUN_POST_GRT_RESIZER_TIMING": true,
    "RUN_MAGIC_DRC": true,
    "RUN_LVS": true,
    "RUN_KLAYOUT_DRC": true,
    "RUN_KLAYOUT_XOR": false,
    "ERROR_ON_MAGIC_DRC": true,
    "ERROR_ON_LVS_ERROR": true,
    "pdk::sky130*": {
        "STD_CELL_LIBRARY": "sky130_fd_sc_hd",
        "MAX_FANOUT_CONSTRAINT": 10,
        "MAX_TRANSITION_CONSTRAINT": 0.75
    }
}
